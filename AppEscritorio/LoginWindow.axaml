<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TiendaJuegos.LoginWindow"
        Width="440" Height="560"
        Title="MiTienda"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Border Margin="36" CornerRadius="10" Background="#16202D"
            BoxShadow="0 8 30 0 #60000000" VerticalAlignment="Center">
        <StackPanel Margin="34,32" Spacing="14">
            <TextBlock Text="MiTienda" FontSize="36" FontWeight="Bold"
                       Foreground="#66C0F4" HorizontalAlignment="Center"/>
            <TextBlock Text="Inicia sesion en tu cuenta" Foreground="#C6D4DF"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Text="Usuario" Foreground="#8F98A0"/>
            <TextBox x:Name="TxtUsuario" PlaceholderText="Tu usuario"/>

            <TextBlock Text="Contrasena" Foreground="#8F98A0"/>
            <TextBox x:Name="TxtPassword" PasswordChar="●" PlaceholderText="Tu contrasena"/>

            <Button x:Name="BtnLogin" Classes="primario" Content="Iniciar sesion" Click="OnLogin"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>

            <Button x:Name="BtnRegistro" Classes="enlace" Content="Crear una cuenta nueva"
                    Click="OnAbrirRegistro" HorizontalAlignment="Center"/>

            <TextBlock x:Name="LblMensaje" Foreground="#E74C3C" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
