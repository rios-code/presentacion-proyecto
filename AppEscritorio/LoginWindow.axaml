<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TiendaJuegos.LoginWindow"
        Width="420" Height="540"
        Title="MiTienda"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#171A21">

    <StackPanel Margin="40" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="MiTienda" FontSize="34" FontWeight="Bold"
                   Foreground="#66C0F4" HorizontalAlignment="Center"/>
        <TextBlock Text="Inicia sesion en tu cuenta" Foreground="#C6D4DF"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Text="Usuario" Foreground="#8F98A0"/>
        <TextBox x:Name="TxtUsuario" PlaceholderText="Tu usuario"/>

        <TextBlock Text="Contrasena" Foreground="#8F98A0"/>
        <TextBox x:Name="TxtPassword" PasswordChar="●" PlaceholderText="Tu contrasena"/>

        <Button x:Name="BtnLogin" Content="Iniciar sesion" Click="OnLogin"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Background="#66C0F4" Foreground="#0E141B" FontWeight="Bold"
                Padding="12" Margin="0,10,0,0"/>

        <Button x:Name="BtnRegistro" Content="Crear una cuenta nueva" Click="OnAbrirRegistro"
                HorizontalAlignment="Center" Background="Transparent" Foreground="#66C0F4"/>

        <TextBlock x:Name="LblMensaje" Foreground="#E74C3C" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
    </StackPanel>
</Window>
