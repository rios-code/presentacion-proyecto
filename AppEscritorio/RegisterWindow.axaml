<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TiendaJuegos.RegisterWindow"
        Width="420" Height="560"
        Title="Crear cuenta"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#171A21">

    <StackPanel Margin="40" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="Crear cuenta" FontSize="28" FontWeight="Bold"
                   Foreground="#66C0F4" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Text="Usuario" Foreground="#8F98A0"/>
        <TextBox x:Name="TxtUsuario" PlaceholderText="Minimo 3 caracteres"/>

        <TextBlock Text="Contrasena" Foreground="#8F98A0"/>
        <TextBox x:Name="TxtPassword" PasswordChar="●" PlaceholderText="Minimo 6 caracteres"/>

        <TextBlock Text="Repetir contrasena" Foreground="#8F98A0"/>
        <TextBox x:Name="TxtPassword2" PasswordChar="●" PlaceholderText="Repeti la contrasena"/>

        <Button x:Name="BtnCrear" Content="Crear cuenta" Click="OnCrear"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Background="#5C7E10" Foreground="White" FontWeight="Bold"
                Padding="12" Margin="0,10,0,0"/>

        <Button x:Name="BtnCancelar" Content="Cancelar" Click="OnCancelar"
                HorizontalAlignment="Center" Background="Transparent" Foreground="#8F98A0"/>

        <TextBlock x:Name="LblMensaje" Foreground="#E74C3C" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
    </StackPanel>
</Window>
