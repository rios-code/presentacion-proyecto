<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TiendaJuegos.RegisterWindow"
        Width="440" Height="600"
        Title="Crear cuenta"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Border Margin="36" CornerRadius="10" Background="#16202D"
            BoxShadow="0 8 30 0 #60000000" VerticalAlignment="Center">
        <StackPanel Margin="34,30" Spacing="14">
            <TextBlock Text="Crear cuenta" FontSize="30" FontWeight="Bold"
                       Foreground="#66C0F4" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Usuario" Foreground="#8F98A0"/>
            <TextBox x:Name="TxtUsuario" PlaceholderText="Minimo 3 caracteres"/>

            <TextBlock Text="Contrasena" Foreground="#8F98A0"/>
            <TextBox x:Name="TxtPassword" PasswordChar="●" PlaceholderText="Minimo 6 caracteres"/>

            <TextBlock Text="Repetir contrasena" Foreground="#8F98A0"/>
            <TextBox x:Name="TxtPassword2" PasswordChar="●" PlaceholderText="Repeti la contrasena"/>

            <Button x:Name="BtnCrear" Classes="exito" Content="Crear cuenta" Click="OnCrear"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>

            <Button x:Name="BtnCancelar" Classes="enlace" Content="Cancelar" Click="OnCancelar"
                    HorizontalAlignment="Center"/>

            <TextBlock x:Name="LblMensaje" Foreground="#E74C3C" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
